{
    "name": "goodchancer/bot-lab",
    "description": "Self-hosted studio for designing AI Slack bots: generate a persona and avatar with Claude or OpenAI, then create and install the Slack app automatically.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "anthropic-ai/sdk": "^1.2",
        "guzzlehttp/guzzle": "^7.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "Studio\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Studio\\Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
